# Copy to .env.local for local dev; in production these live ONLY in the
# Vercel dashboard. Never commit real values — this file ships placeholders.

# Bearer secret sent by the mobile app / bookmarklet.
# Generate one:  openssl rand -hex 32
APP_SECRET=replace-me

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Newer projects: sb_secret_… (service role). On older projects the variable
# is named SUPABASE_SERVICE_ROLE_KEY — either name works.
SUPABASE_SECRET_KEY=replace-me

# Phase ④ (AI layer) — Gemini native (primary). Key format: AIza…
# Create at https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Optional: any OpenAI-compatible endpoint instead of/alongside Gemini
# (OpenAI, Groq, OpenRouter, self-hosted). GEMINI_API_KEY wins when both set.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional — only for MANUAL runs of /api/cron/sweep (the daily cron is
# parked as a future improvement; see PLAN.md)
CRON_SECRET=replace-me
